# PostgreSQL connection string (Neon / Supabase / Render in production)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DBNAME?schema=public&sslmode=require"
# Secret used to sign session tokens. Use a long random value in production.
JWT_SECRET="replace-with-a-long-random-secret"
# Public base URL used when generating QR codes and links.
NEXT_PUBLIC_APP_URL="https://your-deployment-url.vercel.app"
