// Prisma schema for the Event Registration Platform.
// Data model notes live in the project documentation (System Design section).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN // platform-wide oversight, sees every event
  ORGANIZER // owns events, full control over their own
  MANAGER // assigned by an organizer to run registration on the ground
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  role         Role     @default(ORGANIZER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  events       Event[]           @relation("OrganizerEvents")
  assignments  EventManager[]
}

model Event {
  id          String   @id @default(uuid())
  slug        String   @unique // used in the public registration URL
  title       String
  description String?
  venue       String?
  startsAt    DateTime?
  endsAt      DateTime?
  logoData    String?  // base64 data URL, embedded in the QR canvas
  status      EventStatus @default(DRAFT)

  // Dynamic registration form. Stored as an ordered array of field definitions.
  // Each field: { key, label, type, required, options? }
  formSchema  Json     @default("[]")

  // Benefits attendees receive for registering (e.g. free airtime, popcorn).
  benefits    Json     @default("[]")

  // When true, each registration is issued a unique redeemable code. When false
  // the event just captures attendance and no code is handed out.
  codesEnabled Boolean @default(true)

  // Optional custom confirmation shown to the attendee after registering.
  // When null, a sensible default is used (which depends on codesEnabled).
  confirmationTitle   String?
  confirmationMessage String?

  // Public "Register" button label and the fine print shown beneath it. Null
  // falls back to the built-in wording.
  registerButtonText String?
  registerButtonNote String?

  // How many times a single code may be redeemed. 1 = single use (default),
  // 0 = unlimited, any other N = up to N times.
  maxRedemptions Int @default(1)

  // Registration-page branding. Null falls back to the Kinetic Pulse defaults.
  themePrimary String? // hex, e.g. "#5D3FD3"
  themeAccent  String? // hex, e.g. "#00F5FF"

  // Whether the organizer's logo is painted into the centre of the QR code.
  embedLogoInQr Boolean @default(true)

  // Geofenced presence check. When requireLocation is on, attendees are asked
  // to share their location and each registration is flagged on-site/off-site.
  // enforceLocation additionally blocks registration from outside the geofence;
  // when it is off (the default), off-site people can still register.
  requireLocation Boolean @default(false)
  enforceLocation Boolean @default(false)
  latitude        Float?
  longitude       Float?
  radiusMeters    Int     @default(200)
  locationLabel   String? // human-readable place name for the attendee prompt

  // Send the registration code to the attendee by SMS (GiantSMS) when possible.
  smsEnabled Boolean @default(false)

  // Organizer-authored SMS body. Supports {code}, {event}, {name}, {venue} and
  // {date} placeholders. Null uses the built-in message.
  smsTemplate String?

  // Secure check-in: registration requires a short-lived signed token from the
  // live entrance display, so a screenshotted or forwarded QR cannot be reused.
  secureCheckin Boolean @default(false)

  organizerId String
  organizer   User     @relation("OrganizerEvents", fields: [organizerId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  registrations Registration[]
  scans         ScanEvent[]
  managers      EventManager[]

  @@index([organizerId])
}

enum EventStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

// Join table letting an organizer delegate an event to other users.
model EventManager {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([eventId, userId])
  @@index([userId])
}

model Registration {
  id           String   @id @default(uuid())
  // Human-friendly code handed to the attendee. Null when the event has codes
  // disabled. Unique across all issued codes (Postgres permits multiple NULLs).
  code         String?  @unique
  eventId      String
  event        Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // Answers to the dynamic form, keyed by field key.
  data         Json

  redeemed     Boolean  @default(false)
  redeemedAt   DateTime? // time of the most recent redemption
  redeemCount  Int      @default(0) // how many times it has been redeemed

  // Presence at registration. atVenue: true = inside the geofence, false =
  // outside, null = location not shared or not checked. distanceMeters is the
  // measured distance from the venue centre when a location was shared.
  atVenue        Boolean?
  distanceMeters Int?

  createdAt    DateTime @default(now())

  @@index([eventId])
  @@index([createdAt])
}

// One row per QR scan / registration-page view, used for analytics.
model ScanEvent {
  id        String   @id @default(uuid())
  eventId   String
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  userAgent String?
  referrer  String?
  createdAt DateTime @default(now())

  @@index([eventId])
  @@index([createdAt])
}

// Fixed-window rate-limit counters, shared across serverless instances. One row
// per (action, client, time-window); expired rows are pruned opportunistically.
model RateLimit {
  key       String   @id // e.g. "register:1.2.3.4:29384756"
  count     Int      @default(0)
  expiresAt DateTime

  @@index([expiresAt])
}
